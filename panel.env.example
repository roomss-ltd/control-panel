# Settings for the Cloudflare Access check, read by run-panel.sh and ensure-panel.sh.
# Copy this file to panel.env (git-ignored) and fill in your own values.
# It is sourced by the shell, so keep it to plain NAME=value lines.

# Your Cloudflare Zero Trust team name: the <team> in <team>.cloudflareaccess.com.
CF_TEAM=your-team

# The AUD tag of the Cloudflare Access application that protects the panel's hostname
# (Zero Trust dashboard -> Access -> Applications -> your app -> Overview).
CF_AUD=your-access-app-aud

# Optional: repositories the CI page checks on the cloud side, as comma-separated owner/repo.
# Leave unset and that part of the page is just empty.
# export CP_AWS_REPOS=example-org/example-repo,example-org/another-repo

# Optional: the command the panel types into a new pane to start Claude Code (and, with --resume <session id>, to
# resume it). Default: claude. Add flags to run agents without permission prompts (the panel already surfaces
# on-screen questions); without them, Claude asks for permissions as normal.
# export CP_CLAUDE_CMD="claude --dangerously-skip-permissions"
